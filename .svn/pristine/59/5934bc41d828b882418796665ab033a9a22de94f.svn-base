void Get_Temperature_BT_Response(char *Status_State, uint16_t Current_Temp)
{
    
        char TxBuffer_NACK[64];

        /* Only transmit if Bluetooth is actively connected */
        if (PRINTER_PDL.BT._GetConnect() != 0)
