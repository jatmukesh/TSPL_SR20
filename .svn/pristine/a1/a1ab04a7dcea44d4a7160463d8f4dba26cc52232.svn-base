/**
	* @FuncName  DisplayLogo
	* @param     void
	* @retval    void
		* @LocalVar  None
		* @GlobalVar GhDisplayBuffer, PosiflowLogo, StarLogo
		* @Description Copies the monochrome boot splash screen bitmap image array into
		*              the OLED display frame buffer (`GhDisplayBuffer`).
		*
		*              Branding Feature Integration (#ifdef POSIFLOW_LOGO_AND_NAME):
		*              - Loads `PosiflowLogo` bitmap array (width = PosiflowLogo[0], height =
										 PosiflowLogo[1],
		*                pixel data pointer = &PosiflowLogo[2]) via `SetMapToDisplayBuffer()`.
		*              - If disabled, loads fallback `StarLogo`(POSIFLOW TExT) bitmap array.
	*/
void DisplayLogo(void)
{
		SetMapToDisplayBuffer(GhDisplayBuffer,0,0,PosiflowLogo[0],PosiflowLogo[1],(unsigned char*)&PosiflowLogo[2]);
}	
#else
void DisplayLogo(void)
{

SetMapToDisplayBuffer(GhDisplayBuffer,0,0,StarLogo[0],StarLogo[1],(unsigned char*)&StarLogo[2]);

}	
#endif		
		
		
void SetBattyStatus(unsigned char x,unsigned char y,unsigned short mstsa)
{
	switch(mstsa)
	{
		case 0:
			
			break;
		case 1:
			SetMapToDisplayBuffer(GhDisplayBuffer,x,y,Batty25[0],Batty25[1],(unsigned char*)&Batty25[2]);
			break;
		case 2:
			SetMapToDisplayBuffer(GhDisplayBuffer,x,y,Batty50[0],Batty50[1],(unsigned char*)&Batty50[2]);
			break;
		case 3:
			SetMapToDisplayBuffer(GhDisplayBuffer,x,y,Batty75[0],Batty75[1],(unsigned char*)&Batty75[2]);
			break;
		case 4:
			SetMapToDisplayBuffer(GhDisplayBuffer,x,y,Batty100[0],Batty100[1],(unsigned char*)&Batty100[2]);
			break;
	}
}

extern const unsigned char Font_2412[];
void GetASCData(unsigned char CodeL,unsigned char * pbuf)
{
	unsigned int data,i,len;
	unsigned int m_GetDataAddrss;
	//24点阵汉字
	m_GetDataAddrss = (unsigned int)((CodeL - 0x20) * 36 );//,
	len = 12;
	
	for(i=0;i<len;i++)
	{
		*pbuf++ = Font_2412[m_GetDataAddrss+i];
		 *pbuf++ = Font_2412[m_GetDataAddrss+i+12];
		*pbuf++ = Font_2412[m_GetDataAddrss+i+24];
	}
}
void Get8x16ASCData(unsigned char CodeL,unsigned char * pbuf)
{
	unsigned int data,i,len;
	char* m_charbuf;
	//24点阵汉字
	if(m_charbuf)
	{
		m_charbuf = (char*) Char_8x16_list[CodeL-0x20];
	}
	len = m_charbuf[0]*2 + 2;
	for(i=0;i<len;i++)
	{
		pbuf[i] = m_charbuf[i];
	}
}
unsigned char DisplayStrchar(char * pstr,unsigned char x,unsigned char y)
{
	unsigned char index;
	unsigned char mbffer[128];
	index = 0;

	while ( pstr[index]!='\0' )
	{		
		GetASCData( pstr[index],&mbffer[2]);
		mbffer[0] = 12;
		mbffer[1] = 24;
		SetMapToDisplayBuffer(GhDisplayBuffer,x,y,mbffer[0],mbffer[1],(unsigned char*)&mbffer[2]);
		x += 12;
		if( x > 128 )
		{  
			x=0;
			y+=3;
		}
		index++;
	}	
	return  x;
	
}	

unsigned char DisplayStr8x16char(char * pstr,unsigned char x,unsigned char y,unsigned char msp)
{
	unsigned char index;
	unsigned char mbffer[128];
	index = 0;

	while ( pstr[index]!='\0' )
	{		
		memset(mbffer,0,128);
		Get8x16ASCData( pstr[index],mbffer);

		SetMapToDisplayBuffer(GhDisplayBuffer,x,y,mbffer[0]+msp,mbffer[1],(unsigned char*)&mbffer[2]);
		x += mbffer[0]+msp;
		if( x > 128 )
		{  
			x=0;
			y+=3;
		}
		index++;
	}	
	return  x;
}	

unsigned char GetStr8x16Wide(char * pstr,unsigned char msp)
{
	unsigned char index,m_w;
	unsigned char mbffer[128];
	index = 0;
	m_w = 0;
	while ( pstr[index]!='\0' )
	{		
		memset(mbffer,0,128);
		Get8x16ASCData( pstr[index],mbffer);

		m_w += mbffer[0]+msp;
		index++;
	}	
	return  m_w;
}


unsigned char  oled_ClearMap(unsigned char x,unsigned char y,unsigned char mClearwide )
{

	unsigned char mbffer[128];
	memset(mbffer,0,128);
	SetMapToDisplayBuffer(GhDisplayBuffer,x,y,mClearwide,8,(unsigned char*)mbffer);
	return mClearwide+x;
}

const unsigned char  BT_NO_CONNECT[]=
{
0x0C,0x0D,
0x00,0x00,0x00,0x00,0x10,0x20,0x08,0x40,0x04,0x80,0xFF,0xF8,
0x82,0x08,0x45,0x10,0x28,0xA0,0x10,0x40,0x00,0x00,0x00,0x00,

};
const unsigned char  BT_CONNECT[]=
{
0x0C,0x0D,
0x3F,0xE0,0x7F,0xF0,0xEF,0xD8,0xF7,0xB8,0xFB,0x78,0x80,0x08,
0xBD,0xE8,0xBA,0xE8,0xD7,0x58,0xEF,0xB8,0x7F,0xF0,0x3F,0xE0,

};

/**
	* @FuncName  DisplayBT
	* @param     unsigned char x   - X-coordinate position on OLED display
	*            unsigned char y   - Y-coordinate position on OLED display
	*            unsigned char mbt - Connection state flag (1 = Connected/Paired, 0 = Disconnected)
	* @retval    void
	* @LocalVar  const unsigned char TEXT_PADDING - Pixel padding gap between BT icon and text
								string (2 pixels)
	*            unsigned char text_start_x       - Calculated X position where "Paired " text begins
	* @GlobalVar GhDisplayBuffer, BT_CONNECT, BT_NO_CONNECT
	* @Description Renders the Bluetooth status icon and connection text label on the OLED display.
	*
	*              BLUETOOTH_PAIRED_TEXT Breakdown:
	*              - If `mbt == 1` (Connected):
	*                1. Copies `BT_CONNECT` bitmap icon into display buffer (`GhDisplayBuffer`).
	*                2. Calculates text start position: `text_start_x = x + BT_CONNECT[0] + TEXT_PADDING`.
	*                3. Renders `"Paired "` string using 6x8 font (`DisplayStr6x8`).
	*                4. Flushes buffer to hardware screen (`DisplayBufEn()`).
	*              - If `mbt == 0` (Disconnected):
	*                1. Copies `BT_NO_CONNECT` bitmap icon into display buffer.
	*                2. Clears text area by overwriting with spaces (`"       "`).
	*                3. Flushes buffer to hardware screen (`DisplayBufEn()`).
	*/
void DisplayBT(unsigned char x,unsigned char y,unsigned char mbt)
{
#ifdef BLUETOOTH_PAIRED_TEXT	
	  const unsigned char TEXT_PADDING = 2; //7
    unsigned char text_start_x;
	
		if(mbt)
		{
			SetMapToDisplayBuffer(GhDisplayBuffer,x,y,BT_CONNECT[0],BT_CONNECT[1],(unsigned char*)&BT_CONNECT[2]);
			text_start_x = x + BT_CONNECT[0] + TEXT_PADDING;
      DisplayStr6x8("Paired ", text_start_x, y);
			DisplayBufEn();
		}
		else
		{
			SetMapToDisplayBuffer(GhDisplayBuffer,x,y,BT_NO_CONNECT[0],BT_NO_CONNECT[1],(unsigned char*)&BT_NO_CONNECT[2]);
			text_start_x = x + BT_NO_CONNECT[0] + TEXT_PADDING;
      DisplayStr6x8("       ", text_start_x, y); 
			DisplayBufEn();
		}
	
#else	
	if(mbt)
	{
		SetMapToDisplayBuffer(GhDisplayBuffer,x,y,BT_CONNECT[0],BT_CONNECT[1],(unsigned char*)&BT_CONNECT[2]);
		DisplayBufEn();
	}
	else
	{
		SetMapToDisplayBuffer(GhDisplayBuffer,x,y,BT_NO_CONNECT[0],BT_NO_CONNECT[1],(unsigned char*)&BT_NO_CONNECT[2]);
		DisplayBufEn();
	}
#endif	
}
		



unsigned char  oled_PrintfMap(unsigned char x,unsigned char y,unsigned char * pMapDat )
{
	SetMapToDisplayBuffer(GhDisplayBuffer,x,y,pMapDat[0],pMapDat[1],(unsigned char*)&pMapDat[2]);
	return pMapDat[0]+x;
}





void DisplayBatteryL(unsigned char x,unsigned char y,unsigned char mbarry)
{
	switch(mbarry)
	{
		case 0:
			SetMapToDisplayBuffer(GhDisplayBuffer,x,y,Batty00[0],Batty00[1],(unsigned char*)&Batty00[2]);
		break;
		case 1:
			SetMapToDisplayBuffer(GhDisplayBuffer,x,y,Batty25[0],Batty25[1],(unsigned char*)&Batty25[2]);
		break;
		case 2:
			SetMapToDisplayBuffer(GhDisplayBuffer,x,y,Batty50[0],Batty50[1],(unsigned char*)&Batty50[2]);
		break;
		case 3:
			SetMapToDisplayBuffer(GhDisplayBuffer,x,y,Batty75[0],Batty75[1],(unsigned char*)&Batty75[2]);
		break;
		case 4:
			SetMapToDisplayBuffer(GhDisplayBuffer,x,y,Batty100[0],Batty100[1],(unsigned char*)&Batty100[2]);
		break;
	}
	DisplayBufEn();
}

