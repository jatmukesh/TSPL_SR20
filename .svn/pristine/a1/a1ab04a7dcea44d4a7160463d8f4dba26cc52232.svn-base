void SetPrinterStatus(unsigned char x,unsigned char y,unsigned short mstsa)
{
	if(mstsa == 0)
	{
		SetMapToDisplayBuffer(GhDisplayBuffer,x,y,NoPaper[0],NoPaper[1],(unsigned char*)&NoPaper[2]);
	}
	else
	{
		SetMapToDisplayBuffer(GhDisplayBuffer,x,y,NoPaperNULL[0],NoPaperNULL[1],(unsigned char*)&NoPaperNULL[2]);
	}
}

void SetCoverStatus(unsigned char x,unsigned char y,unsigned short mstsa)
{
	if(mstsa==0)
	{
		SetMapToDisplayBuffer(GhDisplayBuffer,x,y,CoverOpen[0],CoverOpen[1],(unsigned char*)&CoverOpen[2]);
	}
	else
	{
		SetMapToDisplayBuffer(GhDisplayBuffer,x,y,CoverNULL[0],CoverNULL[1],(unsigned char*)&CoverNULL[2]);
	}

}


