void iicdelay(unsigned int t)
{
	unsigned int i,j;
	for(i=0;i<t;i++)
	{
		for(j=0;j<20;j++);
	}
}

//---------------------------------------------------------------------
void delflash()

{ unsigned short t1;
	t1= 4 *8 ;

   while(t1>0)t1--;

}
#define IIC_DEL_TIME	20
void I2C_delay(void)
{        
	unsigned short i; //这里可以优化速度        ，经测试最低到5还能写入
	i=IIC_DEL_TIME;
	PRINTER_PDL.SYS._DelayNus(i);
}
void Delay(unsigned short DelayCount)					//1us
{
	I2C_delay();
}

void R8025_IICStart(void)
{
	PRINTER_PDL.SYS._WDG_ReloadCounter();
	Delay(IIC_DEL_TIME);
	//SDA_H;
	PRINTER_PDL.IIC._SDA_H();
	Delay(IIC_DEL_TIME);
	//SCL_H;
	PRINTER_PDL.IIC._SCL_H();
	I2C_delay();
	//SDA_L;
	PRINTER_PDL.IIC._SDA_L();
	I2C_delay();
	//SCL_L;
	PRINTER_PDL.IIC._SCL_L();
	Delay(IIC_DEL_TIME);

}

void R8025_IICStop(void)
{
	PRINTER_PDL.SYS._WDG_ReloadCounter();
	//SCL_L;
	PRINTER_PDL.IIC._SCL_L();
	Delay(IIC_DEL_TIME);
	//SDA_L;
	PRINTER_PDL.IIC._SDA_L();
	Delay(IIC_DEL_TIME);
	//SCL_H;
	PRINTER_PDL.IIC._SCL_H();
	I2C_delay();
	//SDA_H;
	PRINTER_PDL.IIC._SDA_H();
	I2C_delay();
}

void R8025_IICAck(void)
{       
PRINTER_PDL.SYS._WDG_ReloadCounter();	
	//SDA_L;
	PRINTER_PDL.IIC._SCL_L();
	PRINTER_PDL.IIC._SDA_L();	
	Delay(IIC_DEL_TIME);
	//SCL_H;
	PRINTER_PDL.IIC._SCL_H();
	I2C_delay();
	//SCL_L;
	PRINTER_PDL.IIC._SCL_L();
	I2C_delay();
}

void R8025_IICNoAck(void)
{        
	PRINTER_PDL.SYS._WDG_ReloadCounter();
	//SDA_H;
	PRINTER_PDL.IIC._SCL_L();	
	PRINTER_PDL.IIC._SDA_H();
	Delay(IIC_DEL_TIME);
	//SCL_H;
	PRINTER_PDL.IIC._SCL_H();
	I2C_delay();
	//SCL_L;
	PRINTER_PDL.IIC._SCL_L();
}
unsigned char R8025_IICRecAck(void)          //返回为:=0有ACK,=1无ACK
{
	unsigned short mcoutn;
	mcoutn = 0;
	PRINTER_PDL.SYS._WDG_ReloadCounter();
	PRINTER_PDL.IIC._SDA_InputEn();
	Delay(IIC_DEL_TIME);
	//SCL_H;
	PRINTER_PDL.IIC._SCL_H();
	I2C_delay();
	
	while(PRINTER_PDL.IIC.SDA_read())
	{
		mcoutn++;
		if(mcoutn > 1000)
		{
			R8025_IICStop();
			 return 1;
		}
	}

	PRINTER_PDL.IIC._SCL_L();
	return 0;
}

void R8025_IICSendByte(unsigned char SendByte) //数据从高位到低位//
{
    unsigned char i,m_SendByte;
	m_SendByte = SendByte;
	PRINTER_PDL.SYS._WDG_ReloadCounter();
    i=8;
    //SCL_L;
		PRINTER_PDL.IIC._SCL_L();
    while(i--)
    {
			I2C_delay();
			if(m_SendByte&0x80)
				//SDA_H;  
				PRINTER_PDL.IIC._SDA_H();
			else 
				//SDA_L;   
				PRINTER_PDL.IIC._SDA_L();
			m_SendByte = (m_SendByte<< 1);
			I2C_delay();
			//SCL_H;
			PRINTER_PDL.IIC._SCL_H();
			I2C_delay();
			//SCL_L;
			PRINTER_PDL.IIC._SCL_L();
    }

}

unsigned char R8025_IICReceiveByte(void)  //数据从高位到低位//
{ 
    unsigned char i;
    unsigned char ReceiveByte;
	PRINTER_PDL.SYS._WDG_ReloadCounter();
	i=8;
	ReceiveByte=0;
	I2C_delay();
  //SDA_H;                                
	PRINTER_PDL.IIC._SDA_H();
	PRINTER_PDL.IIC._SDA_InputEn();
	while(i--)
	{
		I2C_delay();
		//SCL_H;
		PRINTER_PDL.IIC._SCL_H();
		Delay(IIC_DEL_TIME);
		ReceiveByte = (ReceiveByte<< 1);      
		//if(SDA_read)
		if(PRINTER_PDL.IIC.SDA_read())
		{
			ReceiveByte|=0x01;
		}
		I2C_delay();
		//SCL_L;
		PRINTER_PDL.IIC._SCL_L();
	}
    return ReceiveByte;
}
//---------------------------------------------------------------------
void start()
{
	PRINTER_PDL.SYS._WDG_ReloadCounter();
	delflash();
	PRINTER_PDL.IIC._SDA_H();//sda=1; 
	delflash();
	PRINTER_PDL.IIC._SCL_H();//scl=1;
	delflash(); 
	PRINTER_PDL.IIC._SDA_L();//sda=0; 
	delflash(); 
	PRINTER_PDL.IIC._SCL_L();//scl=0; 
	delflash();
}

//---------------------------------------------------------------------
void stop()
{
	PRINTER_PDL.SYS._WDG_ReloadCounter();
	PRINTER_PDL.IIC._SCL_L();//scl=0; 
	delflash();
	PRINTER_PDL.IIC._SDA_L();//sda=0; 
	delflash(); 
	PRINTER_PDL.IIC._SCL_H();//scl=1;
	delflash(); 
	PRINTER_PDL.IIC._SDA_H();//sda=1;  
	delflash(); 
}

//---------------------------------------------------------------------
void write_byte(unsigned char dat)
{
	
	unsigned short k,i;
	PRINTER_PDL.SYS._WDG_ReloadCounter();
	i=200 * 96;
	PRINTER_PDL.IIC._SCL_L();//scl=0; 
			delflash();
	for (k=0;k<8;k++)
	{  

		
		//sda=CY;
		if(dat & 0x80)
		{
			PRINTER_PDL.IIC._SDA_H();//sda=1;  
		}
		else
		{
			PRINTER_PDL.IIC._SDA_L();//sda=0; 
		}
		dat=dat<<1;
		delflash();
		PRINTER_PDL.IIC._SCL_H();//scl=1;
		delflash();
		PRINTER_PDL.IIC._SCL_L();//scl=0; 
		delflash();
	}
	PRINTER_PDL.IIC._SDA_H();//sda=1;  
	delflash ();
	PRINTER_PDL.IIC._SCL_H();//scl=1;
	delflash();
	PRINTER_PDL.IIC._SDA_InputEn();
	while (GET_SDA_OUT && i--);
	PRINTER_PDL.IIC._SCL_L();//scl=0; 
}

//---------------------------------------------------------------------
void oled_init(void)
 {
   PRINTER_PDL.IIC._RST_H();//RES=1;
   delaynms(100);
   PRINTER_PDL.IIC._RST_L();//RES=0;
   delaynms(100);
   PRINTER_PDL.IIC._RST_H();//RES=1;
   delaynms(100);

   start();
   write_byte(0x78);//set slave adress

   write_byte(0x80);
   write_byte(0xAE);//set display display ON/OFF,AFH/AEH

   write_byte(0x80);	
   write_byte(0x40);//set display start line:COM0	

   write_byte(0x80);
   write_byte(0x81);//set contrast control
   write_byte(0x80);
   write_byte(0xB3);	
   
   write_byte(0x80);
   write_byte(0x20);//set memory addressing mode
   write_byte(0x80);
   write_byte(0x02);//page addressing mode		
   
   write_byte(0x80);
   write_byte(0xA0);//set segment re-map
   
   write_byte(0x80);
   write_byte(0xA4);//entire display on: A4H:OFF/A5H:ON

   write_byte(0x80);
   write_byte(0xA6);//set normal/inverse display: A6H:normal/A7H:inverse

   write_byte(0x80);
   write_byte(0xA8);//set multiplex ratio
   write_byte(0x80);
   write_byte(0x1F);//1/32duty
   
   write_byte(0x80);
   write_byte(0xC0);//0xC0set com output scan direction

   write_byte(0x80);
   write_byte(0xD3);//set display  offset
   write_byte(0x80);
   write_byte(0x00);//

   write_byte(0x80);
   write_byte(0xD5);//set display  clock divide ratio/oscillator frequency
   write_byte(0x80);
   write_byte(0x80);//0x20 105Hz

   write_byte(0x80);
   write_byte(0xD9);//set pre-charge period
   write_byte(0x80);
   write_byte(0x1F);//

   write_byte(0x80);
   write_byte(0xDA);//set com pins hardware configuration
   write_byte(0x80);
   write_byte(0x02);//

   write_byte(0x80);
   write_byte(0xDB);//set vcomh deselect level
   write_byte(0x80);
   write_byte(0x30);//0.83*VCC

   write_byte(0x80);		
   write_byte(0x8D);//charge pump setting
   write_byte(0x80);
   write_byte(0x94);//enable charge pump,VCC=8.5V
   write_byte(0x80);
   write_byte(0xAE);//0xAFset display display ON/OFF,AEH/AFH 
 stop();
 
ClearDisplayBuf();
DisplayBufEn();
   start();
   write_byte(0x78);//set slave adress
	   write_byte(0x80);
   write_byte(0xAF);//0xAFset display display ON/OFF,AEH/AFH 
 stop();

  }

//--------------------------------------------------------------------- 
void oled_SetPostion( unsigned char x, unsigned char y) 
{ 
	write_byte(0x80);
	write_byte(0xB0+y);//set page address	

	write_byte(0x80);
	write_byte(x&0x0f);  //set col address LSB
	write_byte(0x80);
	write_byte(((x&0xf0)>>4)|0x10);  //set col address MSB
} 

void SetDatScreen(unsigned int * Displaybuffer)	// DisplayData should be 164x64/8 = 1312byte
{
	unsigned char i, j,k;
	unsigned int m_dat;

	
	for(i=0;i<4;i++)
	{
		start();		
		write_byte(0x78);  //set slave adress		

     write_byte(0x80);
     write_byte(0xB0+i);//set page address

     write_byte(0x80);
     write_byte(0x00);  //set col address LSB
     write_byte(0x80);
     write_byte(0x10);  //set col address MSB

     write_byte(0x40); 
		
		k =  i * 8;
		for(j=0;j<128;j++)
		{
			m_dat = ((Displaybuffer[127-j]) >> k) & 0xFF;
			write_byte(m_dat) ;//显示一屏数据
		}
	stop();				
	}


}
//所有图形存储的方式都是纵向，低对齐
void SetMapToDisplayBuffer(unsigned int * ProDisplayBuffer,unsigned short x,unsigned short y,unsigned short w,unsigned short h,unsigned char  * MapBuffer)
{
  short i,k,num;
	unsigned int dat,datand,dat_and;
	short space_x;
	datand = 0xFFFFFFFF;
	
	i = 32 - h;
	datand = datand <<	i;
	datand = datand >> y;
	
	dat_and = ~datand;

	num = (h + 7)/8;//得到8的整数倍

	space_x = x;
	for(i=0;i<w;i++)
	{
		//IWDG_ReloadCounter(); //reload the watchdog 重装载看门狗定时器
		dat = 0;
		for(k=0;k<num;k++)
		{
			dat = dat << 8;
			dat |= *MapBuffer++;
		}

		if(h & 7)
		{
			k = 8 - (h%8);
			dat = dat >> k;
		}
		
		dat = dat <<(32 - y - h);

		ProDisplayBuffer[space_x] &= dat_and;
		ProDisplayBuffer[space_x] |= dat & datand;
		space_x++;

	}
}
void oled_Clear(void)  
{  
  unsigned char i,n;
 start();
 write_byte(0x78);  //set slave adress	
  for(i=0;i<4;i++)  
  {  
			oled_SetPostion(0,i);	
      for( n = 0;n < 128; n++)
      {
         write_byte(0x00);
      } 
  } 
	stop();
	for(i=0;i<128;i++)
	{
		GhDisplayBuffer[i] = 00;
	}		
	
}
void DisplayBufEn(void)  
{
	#ifdef FIXED_LATE_BATTERY_DISPLAY
	if (g_DisplayHoldOff)
	{
			return; // Suppress partial transmission while batching
	}
	SetDatScreen(GhDisplayBuffer);
	#else
	SetDatScreen(GhDisplayBuffer);					
	#endif					
}
void ClearDisplayBuf(void)  
{
	unsigned char i;
	for(i=0;i<128;i++)
	{
		GhDisplayBuffer[i] = 00;
	}			
}
void Get6x8CharBuffer(unsigned char code,unsigned char * DotBuffer)
{
	unsigned int m_GetData;
	unsigned short i,j;

	i = (code - 0x20) * 2;
	m_GetData = CHAR_6X8_1[i];
	j = 0;
	DotBuffer[j++] = m_GetData >> 24;
	DotBuffer[j++] = m_GetData >> 16;
	DotBuffer[j++] = m_GetData >> 8;
	DotBuffer[j++] = m_GetData & 0xFF;

	m_GetData = CHAR_6X8_1[i+1];
	DotBuffer[j++] = m_GetData >> 24;
	DotBuffer[j++] = m_GetData >> 16;
}

void DisplayStr6x8(char * pstr,unsigned char x,unsigned char y)
{
	unsigned char i,index;
	unsigned char character;
	unsigned char mbuf[32];
	index = 0;
	
	while ( pstr[index]!='\0' )
	{		
		Get6x8CharBuffer(	pstr[index],mbuf);
		SetMapToDisplayBuffer(GhDisplayBuffer,x,y,6,8,(unsigned char*)mbuf);		
		
		x += 6;
		if( x > 128 )
		{  
			x=0;
			y+=1;
		}
		index++;
	}	

}


