unsigned char ReadByte (unsigned int Addr)
{
	unsigned int SendAddr;
	unsigned char SendBuffer[16];
	unsigned char ReceiveBuffer[16];	
	while((RDSR() & 1) == 1);
	SendAddr = Addr+ 0x03000000;//(Page << 10) + Offset + 0xE8000000;
	SendBuffer[0] = SendAddr >> 24;
	SendBuffer[1] = SendAddr >> 16;
	SendBuffer[2] = SendAddr >> 8;
	SendBuffer[3] = SendAddr ;
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,4,ReceiveBuffer,1);
	return ReceiveBuffer[0];
}
void ReadNBytes (unsigned int Addr,unsigned char *bufferDatChar,unsigned short len)
{
	unsigned int SendAddr;
	unsigned char SendBuffer[16];
	//unsigned char ReceiveBuffer[16];	
	while((RDSR() & 1) == 1);
	SendAddr = Addr+ 0x03000000;//(Page << 10) + Offset + 0xE8000000;
	SendBuffer[0] = SendAddr >> 24;
	SendBuffer[1] = SendAddr >> 16;
	SendBuffer[2] = SendAddr >> 8;
	SendBuffer[3] = SendAddr ;
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,4,bufferDatChar,len);

}


//1F8000 32K 数据存放地址

/************************************************************************
* 名称: WREN_Check
* 功能: 检查擦写操作前WEL位是否为1
* 输入:
* 返回:
************************************************************************/
void WREN_Check(void)
{
 unsigned char byte;
 byte = RDSR(); /* 读取状态register */
 if ((byte&0x02) != 0x02)  /* 检查WEL位置位 */
 {
  WREN();
   //如果未置1进行相应处理,如对其进行写使得操作
 }
}

void PowerDown (void)
{
	unsigned char SendBuffer[16];
	SendBuffer[0] = 0xB9;
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,1,0,0);
}

void MX_Resume (void)
{
	unsigned char SendBuffer[16];
	SendBuffer[0] = 0xAB;
	SendBuffer[1] = 0xFF;
	SendBuffer[2] = 0xFF;
	SendBuffer[3] = 0xFF;
	SendBuffer[4] = 0xFF;
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,5,0,0);	
}
void WREN(void)
{

	unsigned char SendBuffer[16];
	SendBuffer[0] = 0x06;
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,1,0,0);
}
void WRDI(void)
{
	unsigned char SendBuffer[16];
	SendBuffer[0] = 0x04;
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,1,0,0);
}

//擦除起始地址0x1F8000  的32K数据



void ERASE_32K(void)
{
	unsigned int i,addr;

	addr = 0x1F8000;
	for(i=0;i<8;i++)
	{
		ERASE_4K(addr);
		addr += 0x1000;
	}

}

void ERASE_4K(unsigned int Addr)
{
	unsigned int SendAddr;
	unsigned int i;
	unsigned char SendBuffer[16];
	while((RDSR() & 1) == 1);
	PRINTER_PDL.SYS._WDG_ReloadCounter();  // reload the watchdog 重装载看门狗定时器
	WREN();

	WREN_Check();
	for(i=0;i<0x100;i++);
	SendAddr = Addr+ 0x20000000;//(Page << 10) + Offset + 0xE8000000;
	SendBuffer[0] = SendAddr >> 24;
	SendBuffer[1] = SendAddr >> 16;
	SendBuffer[2] = SendAddr >> 8;
	SendBuffer[3] = SendAddr ;
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,4,0,0);	
	
	while((RDSR() & 1) == 1);
}

unsigned char RDSR (void)
{
	unsigned char SendBuffer[16];
	unsigned char ReceiveBuffer[16];	
	SendBuffer[0] = 0x05;
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,1,ReceiveBuffer,1);
	return ReceiveBuffer[0];
}

void WRSR(void)
{
	unsigned char sta;
	unsigned char SendBuffer[16];
	sta = RDSR();
	sta &= 0xE3;
	sta |= 0x80;
	//写使能状态寄存器
	SendBuffer[0] = 0x50;
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,1,0,0);
	//写状态寄存器	所有扇区不保护
	SendBuffer[0] = 0x01;
	SendBuffer[1] = sta;
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,2,0,0);
}

void SST25V_DBSY(void)
{
	unsigned char SendBuffer[16];
	SendBuffer[0] = 0x80;
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,1,0,0);
}

unsigned short RD_ID(void)
{
	unsigned char SendBuffer[16];
	unsigned char ReceiveBuffer[16];	
	SendBuffer[0] = 0x90;
	SendBuffer[1] = 0x0;
	SendBuffer[2] = 0x0;
	SendBuffer[3] = 0x01;
	
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,4,ReceiveBuffer,2);	
	
	return(ReceiveBuffer[0] | (ReceiveBuffer[1]<<8));
	 
}

void AT91F_DataFlashPageWrite (unsigned int PageAddr,unsigned short *dataBuffer)
{
	unsigned int SendAddr,mCount;
	unsigned int i;
	unsigned char k;
	unsigned short temp;
	unsigned short *Getdatabuffer;
	unsigned char SendBuffer[1024];
	Getdata_ok = 0;
	Getdatabuffer = dataBuffer;
	PRINTER_PDL.SYS._WDG_ReloadCounter();  // reload the watchdog 重装载看门狗定时器
	for(k=0;k<2;k++)
	{
		SendAddr = PageAddr & 0xfffff000;
		Erase_Sector = Erase_Sector & 0xfffff000;

		if(Erase_Sector != SendAddr)
		{
			Erase_Sector = SendAddr;

			WREN();

			ERASE_4K(PageAddr);
		}

		WREN();
		for(i=0;i<0x100;i++);
		while((RDSR() & 1) == 1);
	
		mCount = 0;

		SendAddr = PageAddr+ 0x02000000;//页写命令
		SendBuffer[mCount++] = SendAddr >> 24;
		SendBuffer[mCount++] = SendAddr >> 16;
		SendBuffer[mCount++] = SendAddr >> 8;
		SendBuffer[mCount++] = SendAddr ;
		
		for(i=0;i<128;i++)
		{
			temp = *Getdatabuffer++	;
			SendBuffer[mCount++] = (temp >> 8) & 0xFF;//发送数据
			SendBuffer[mCount++] = temp & 0xFF;//发送数据
		}
		
		
		PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,mCount,0,0);	
	
		for(i=0;i<0x100;i++);
		while((RDSR() & 1) == 1);

		PageAddr += 256;

	}
	Getdata_ok = 0xaa;
}

void AT91F_DataFlashPageWrite_NE (unsigned int PageAddr,unsigned short *dataBuffer)
{
	unsigned int i,mCount,SendAddr;

	unsigned short temp;
	unsigned short *Getdatabuffer;
	unsigned char SendBuffer[1024];
	Getdata_ok = 0;
	Getdatabuffer = dataBuffer;
	PRINTER_PDL.SYS._WDG_ReloadCounter();  // reload the watchdog 重装载看门狗定时器

	WREN();
	WREN_Check();
	for(i=0;i<0x100;i++);
	mCount = 0;

	SendAddr = PageAddr+ 0x02000000;//页写命令
	SendBuffer[mCount++] = SendAddr >> 24;
	SendBuffer[mCount++] = SendAddr >> 16;
	SendBuffer[mCount++] = SendAddr >> 8;
	SendBuffer[mCount++] = SendAddr ;
		

	for(i=0;i<128;i++)
	{
			temp = *Getdatabuffer++	;
			SendBuffer[mCount++] = (temp >> 8) & 0xFF;//发送数据
			SendBuffer[mCount++] = temp & 0xFF;//发送数据
	}

	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,mCount,0,0);	
	
	for(i=0;i<0x100;i++);
	while((RDSR() & 1) == 1);


	Getdata_ok = 0xaa;
}

///flash中数据按照低位在前 高位在后
//每页有256个字节
void AT91F_WritenOrderBytes (unsigned int dataAddr,unsigned char *dataBuffer,unsigned short len)
{
	unsigned int i,SendAddr,mCount;

	unsigned char *Getdatabuffer;
	unsigned char SendBuffer[1024];
	if(len == 0)
	{
		return;
	}
	Getdata_ok = 0;
	Getdatabuffer = dataBuffer;
	PRINTER_PDL.SYS._WDG_ReloadCounter();  // reload the watchdog 重装载看门狗定时器

	SendAddr = dataAddr & 0xfffff000;
	Order_Erase_Sector = Order_Erase_Sector & 0xfffff000;

	if(Order_Erase_Sector != SendAddr)
	{
		Order_Erase_Sector = SendAddr;

		WREN();

		ERASE_4K(Order_Erase_Sector);
	}


	WREN();
	for(i=0;i<0x100;i++);

	mCount = 0;
	SendAddr = dataAddr+ 0x02000000;//页写命令
	SendBuffer[mCount++] = SendAddr >> 24;
	SendBuffer[mCount++] = SendAddr >> 16;
	SendBuffer[mCount++] = SendAddr >> 8;
	SendBuffer[mCount++] = SendAddr ;

	for(i=0;i<len;i++)
	{
		SendBuffer[mCount++] = Getdatabuffer[g_GetDataOffset++] ;
		g_GetDataOffset &= MASK_DATA;
	}

	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,mCount,0,0);	
	
	for(i=0;i<0x100;i++);

	while((RDSR() & 1) == 1);

}
///flash中数据按照低位在前 高位在后
//每页有256个字节
void AT91F_WritenNBytes (unsigned int dataAddr,unsigned char *dataBuffer,unsigned short len)
{
	unsigned short i,mCount;
	unsigned int SendAddr;

	unsigned char SendBuffer[1024];
	if(len == 0)
	{
		return;
	}
	Getdata_ok = 0;
	PRINTER_PDL.SYS._WDG_ReloadCounter();  // reload the watchdog 重装载看门狗定时器

	WREN();
	for(i=0;i<0x100;i++);
	mCount = 0;
	SendAddr = dataAddr+ 0x02000000;//页写命令
	SendBuffer[mCount++] = SendAddr >> 24;
	SendBuffer[mCount++] = SendAddr >> 16;
	SendBuffer[mCount++] = SendAddr >> 8;
	SendBuffer[mCount++] = SendAddr ;

	for(i=0;i<len;i++)
	{
		SendBuffer[mCount++] = dataBuffer[i];
	}
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,mCount,0,0);	
	while((RDSR() & 1) == 1);
}



#ifdef CHECKSUM

uint32_t Flash_Checksum_Calculation(void)
{
	  uint32_t checksum = 0;
    uint32_t addr;

	  for (addr = FLASH_START_ADDRESS; addr < FLASH_END_ADDRESS; addr += 2)
    {
			//	// MyPrintf("addr=%X\r\n",addr);
        // 1. XOR the 16-bit word at the current address
        checksum ^= *(volatile uint16_t *)addr;

        // 2. Watchdog Refresh: Every 8KB (0x2000)
        
        if ((addr & 0x1FFF) == 0) 
        {
            PRINTER_PDL.SYS._WDG_ReloadCounter();
        }
    }

	  return checksum;
	
}

extern void Delay1ms(unsigned short mdelay);

void Flash_Checksum_Failed(void)
{
    // Turn on the printer power to display the message
    PRINTER_PDL.SYS._POWER_EN();

    // Initialize OLED display to show error message
    oled_init();
    ClearDisplayBuf();
    
    // Display centered "Checksum Error"
    DisplayStr8x16char("Checksum Error", 8, 0, 0);
    DisplayStr8x16char("ReFlash Firmware", 0, 16, 0);
    
    // Push buffer to OLED
    DisplayBufEn();
    
    // Wait for 5 seconds
    Delay1ms(5000);

    // Turn off the printer power
    PRINTER_PDL.SYS._POWER_DIS();

    // Trap system in infinite loop to prevent further execution
//    while(1)
//    {
//        PRINTER_PDL.SYS._WDG_ReloadCounter();
//    }
}

#endif














