	unsigned int data;
	unsigned short i,m,k,m_RRCount,t_Wide,t_High;
	unsigned short m_CrTim;
unsigned int TempConfig;
	
	
	
	TempConfig = (mChar - 0x20) * 36;
	t_Wide = s_Wide;
	t_High = s_High;
	for(i= 0;i<32;i++)
	{
		DotArry[i] = 0;
	}
	m_RRCount = 24;
	//处理每行数据以8点高度为标准,不够8点的需要按照折半处理

	m_CrTim = t_High >> 3;
	for(i=0;i<m_CrTim;i++)
	{
		m =0;
		for(k=0;k<t_Wide;k++)
		{
			//data = SPI_Send_word(0xFF);
			data = Font_2412[TempConfig++];
			DotArry[m++] |=  (data << m_RRCount);
		}
		m_RRCount -= 8;
	}
	//把字符做横向处理
	Transpose32(DotArry);
	//SPI_MEM2_CS_HIGH();
	return s_Wide;
}


void ReadInFlashAndDeg(unsigned int m_offset,unsigned short s_Wide,unsigned short s_High,unsigned int DotArry[32])
{
	unsigned int m_CharDcount,data,data1;
	unsigned short i,m,k,m_RRCount,t_Wide,t_High;
	unsigned short m_CrTim,m_RetTim;

	t_Wide = s_Wide;
	t_High = s_High;
	for(i= 0;i<32;i++)
	{
		DotArry[i] = 0;
	}
	m_CharDcount = m_offset;
	
	m_RRCount = 24;
	//处理每行数据以8点高度为标准,不够8点的需要按照折半处理
	m_RetTim = 0;
	m_CrTim = t_High >> 3;
	if(t_High & 0x7)
	{
		m_CrTim++;
		m_RetTim = m_CrTim - 1;
	}
	for(i=0;i<m_CrTim;i++)
	{
		if(m_RetTim)
		{
			if(i == m_RetTim)
			{
				m_RetTim = 0xAA;//表示当前行需要处理折半
				data = t_Wide & 1;
				t_Wide = t_Wide >> 1;//需要增加处理9X17字符的功能,目前没有
				if(data)
				{
					t_Wide++;//
				}
			}
		}
		m =0;
		for(k=0;k<t_Wide;k++)
		{
			
			data = Font_2412[m_CharDcount++];
			if(m_RetTim != 0xAA)
			{
				DotArry[m++] |=  (data << m_RRCount);
			}
			else
			{
				data1 = (data & 0xF) << 4;
				data = data & 0xF0;
				DotArry[m++] |=  (data << m_RRCount);
				DotArry[m++] |=  (data1 << m_RRCount);
			}
		}
		m_RRCount -= 8;
	}
	Getdata_ok = 0xaa;
}


void ReadIntAndDeg917(unsigned int Addr,unsigned short s_Wide,unsigned short s_High,unsigned int DotArry[32])
{
	unsigned int data;
	unsigned short i,m,k,m_RRCount,t_Wide,t_High;
	unsigned short m_CrTim;
	unsigned char * p_Char;
	t_Wide = s_Wide;
	t_High = s_High;
	
	p_Char = (unsigned char*)CHAR_9X17 + Addr;
	for(i= 0;i<32;i++)
	{
		DotArry[i] = 0;
	}
	m_RRCount = 24;
	//处理每行数据以8点高度为标准,不够8点的需要按照折半处理
	
	m_CrTim = (t_High +7)/8;//得到循环体高度计数器


	for(i=0;i<m_CrTim;i++)
	{
		m =0;
		for(k=0;k<t_Wide;k++)
		{
			data = *p_Char++;//得到数据
			DotArry[m++] |=  (data << m_RRCount);
		}
		p_Char++;
		m_RRCount -= 8;
	}
	Getdata_ok = 0xaa;
}
void ReadFlashAndDeg(unsigned int Addr,unsigned short s_Wide,unsigned short s_High,unsigned int DotArry[32])
{
	unsigned int SendAddr,data,data1;
	unsigned short i,m,k,m_RRCount,t_Wide,t_High,mWCount;
	unsigned short m_CrTim,m_RetTim;
	unsigned char SendBuffer[16];
	unsigned char ReceiveBuffer[256];

	t_Wide = s_Wide;
	t_High = s_High;
	for(i= 0;i<32;i++)
	{
		DotArry[i] = 0;
	}

	SendAddr = Addr+ 0x03000000;//(Page << 10) + Offset + 0xE8000000;
	SendBuffer[0] = SendAddr >> 24;
	SendBuffer[1] = SendAddr >> 16;
	SendBuffer[2] = SendAddr >> 8;
	SendBuffer[3] = SendAddr ;
	
	
	
	m_RRCount = 24;
	//处理每行数据以8点高度为标准,不够8点的需要按照折半处理
	m_RetTim = 0;
	m_CrTim = t_High >> 3;
	if(t_High & 0x7)
	{
		m_CrTim++;
		m_RetTim = m_CrTim - 1;
	}

	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,4,ReceiveBuffer,m_CrTim*t_Wide);
	mWCount = 0;
	
	for(i=0;i<m_CrTim;i++)
	{
		if(m_RetTim)
		{
			if(i == m_RetTim)
			{
				m_RetTim = 0xAA;//表示当前行需要处理折半
				data = t_Wide & 1;
				t_Wide = t_Wide >> 1;//需要增加处理9X17字符的功能,目前没有
				if(data)
				{
					t_Wide++;//
				}
			}
		}
		m =0;
		for(k=0;k<t_Wide;k++)
		{
	
			data = ReceiveBuffer[mWCount++];;
			
			if(m_RetTim != 0xAA)
			{
				DotArry[m++] |=  (data << m_RRCount);
			}
			else
			{
				data1 = (data & 0xF) << 4;
				data = data & 0xF0;
				DotArry[m++] |=  (data << m_RRCount);
				DotArry[m++] |=  (data1 << m_RRCount);
			}
		}
		m_RRCount -= 8;
	}


	Getdata_ok = 0xaa;
}

void ReadIntFlashAndDeg(unsigned int Addr,unsigned short s_Wide,unsigned short s_High,unsigned int DotArry[32],unsigned char codepage)
{
	unsigned int data,data1;
	unsigned short i,m,k,m_RRCount,t_Wide,t_High;
	unsigned short m_CrTim,m_RetTim;

	unsigned char * p_codepage;

	t_Wide = s_Wide;
	t_High = s_High;
	for(i= 0;i<32;i++)
	{
		DotArry[i] = 0;
	}

	if(codepage == 30)
	{
		p_codepage = (unsigned char *)Cpde_Page30;
	}
	else
	{
		p_codepage = (unsigned char *)Cpde_Page31;
	}
	
	
	p_codepage += Addr;//得到取数据地址

	m_RRCount = 24;
	//处理每行数据以8点高度为标准,不够8点的需要按照折半处理
	m_RetTim = 0;
	m_CrTim = t_High >> 3;
	if(t_High & 0x7)
	{
		m_CrTim++;
		m_RetTim = m_CrTim - 1;
	}
	for(i=0;i<m_CrTim;i++)
	{
		if(m_RetTim)
		{
			if(i == m_RetTim)
			{
				m_RetTim = 0xAA;//表示当前行需要处理折半
				data = t_Wide & 1;
				t_Wide = t_Wide >> 1;//需要增加处理9X17字符的功能,目前没有
				if(data)
				{
					t_Wide++;//
				}
			}
		}
		m =0;
		for(k=0;k<t_Wide;k++)
		{
			data = *p_codepage++;
			if(m_RetTim != 0xAA)
			{
				DotArry[m++] |=  (data << m_RRCount);
			}
			else
			{
				data1 = (data & 0xF) << 4;
				data = data & 0xF0;
				DotArry[m++] |=  (data << m_RRCount);
				DotArry[m++] |=  (data1 << m_RRCount);
			}
		}
		m_RRCount -= 8;
	}
	Getdata_ok = 0xaa;
}

void AT91F_DataFlashADDRRead (unsigned int Addr,unsigned int len, unsigned short *dataBuffer)
{
	unsigned int SendAddr,data,i,m,mWCount;
	unsigned char SendBuffer[16];
	unsigned char ReceiveBuffer[2048];

	SendAddr = Addr+ 0x03000000;//(Page << 10) + Offset + 0xE8000000;
	SendBuffer[0] = SendAddr >> 24;
	SendBuffer[1] = SendAddr >> 16;
	SendBuffer[2] = SendAddr >> 8;
	SendBuffer[3] = SendAddr ;
	
	PRINTER_PDL.SPI._SendAndReceiveData(SendBuffer,4,ReceiveBuffer,len*2);
	mWCount = 0;
	for(i=0;i<len;i++)
	{
		data = ReceiveBuffer[mWCount++];
		m = ReceiveBuffer[mWCount++];
		m |= (data << 8);
		*dataBuffer++ = m;
	}
	Getdata_ok = 0xaa;
}

