	m_GetDataAddrss = m_Reg_R0 ;
	m_Reg_R0 = PrinterCore() & 0xff;
	m_GetDataAddrss += (m_Reg_R0 << 8);
	m_Reg_R0 = PrinterCore() & 0xff;
	m_GetDataAddrss += (m_Reg_R0 << 16);
	m_Reg_R0 = PrinterCore() & 0xff;
	m_GetDataAddrss += m_Reg_R0 << 24;

	for(j=0;j<8;j++)
