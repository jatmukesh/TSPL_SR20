unsigned int __DC2_AB_Order(void)
{
	unsigned char i;
	for(i=0;i<BUFFER_SHORT_LENGTH;i++)
	{
		g_ListTable[i] = 0;
	}
	if(g_SavePrintPos == g_CalcPrintPos)
	{
		for(i=0;i<BUFFER_SHORT_LENGTH;i++)
		{
			p_ListPrease->m_LineProArry[i] = 0;
		}
	}
