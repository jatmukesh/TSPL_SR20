}

/*********************************************************************************************************
** Function name:       unsigned int __ESC_BD_Order(void)
** Descriptions:       测试使用,返回一个扇区的数据
** input parameters:    无
** output parameters:   无
** Returned value:      无
1B BD A0 A1 A2 A3
*********************************************************************************************************/
unsigned int __ESC_BD_Order(void)
{
	unsigned short i,j;
	unsigned int	m_Reg_R0;
	Buffer_writer_I = &(s_ListParmeter_B.m_ListBuffer[700]);//设置指针位置

