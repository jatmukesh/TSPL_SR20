  *********************************************************************************************************/
unsigned int __DC2_40_Order(void)
{
	while(s_PrinterMOTOPar.m_StopPrint != ENABLE_VAR);
	if(PrinterCore()&1)
	{
		g_PaperType = 0 ;
	}
	else
	{
		g_PaperType = 1;
	}

	return PROCESS_CONTINUE;
}

