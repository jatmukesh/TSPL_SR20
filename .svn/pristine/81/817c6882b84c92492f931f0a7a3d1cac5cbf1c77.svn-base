*********************************************************************************************************/
unsigned int __ESC_33_Order(void)
{
	if(g_PaperType == 0)
	{
			return PROCESS_CONTINUE;
	}
	m_GetData = PrinterCore();
	if(m_GetData > 24)
	{
		m_GetData -= 24;
	}
	else
	{
		m_GetData = 0;
	}
	s_PrintParameters.m_LineSpace = m_GetData;
	p_ListPrease->m_PrintLineSpace = m_GetData;
	return PROCESS_CONTINUE;
}

