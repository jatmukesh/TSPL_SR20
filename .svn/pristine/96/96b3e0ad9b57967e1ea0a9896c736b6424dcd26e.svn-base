	{
		Buffer_CodeBar[i] = 0;
	}
	i = 0;
	CodeBarZoom(13,0x12DA);//左护线

	//-------------开头数据
	if(I_BarType == 4)
	{
		m_Barlen = 50;
	}
	else
	{
		m_Barlen = PrinterCore();//得到条码的长度
	}
	while (m_Barlen >0)
	{
