*
* 说  明：
CODE39_S
****************************************************************************/
int ProcessCODE39(unsigned char I_BarType)
{
	unsigned short m_BarData;
	unsigned short m_Barlen;
	unsigned short i,k;
	g_count = 0;
	g_DataBuf = 0;
	i =0;
