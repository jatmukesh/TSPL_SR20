		{
			break;
		}
		CodeBarStr[i++] = m_BarData;
		m_BarData = m_BarData -0x20;
		m_BarData = CODE39_S[m_BarData];

		CodeBarZoom(13,m_BarData);

		m_Barlen--;
	}
	CodeBarZoom(13,0x12DA);//左护线

	g_DataBuf = g_DataBuf << (16 - g_Prolen);
	Buffer_CodeBar[g_count++]= g_DataBuf;

	CodeBarStr[i++] = 0x0d;
	s_PrintOrderstr.m_GetdataPos = i;
	s_PrintOrderstr.pSpecialposition = CodeBarStr;

	if(g_alignType)
	{
		if(g_BarLen < PRINT_HEAD_LENGTH )
		{
			if(g_alignType == 1)
			{
					k = (PRINT_HEAD_LENGTH - g_BarLen )/2;
			}
			else
			{
				k = (PRINT_HEAD_LENGTH - g_BarLen );
			}
		}
		if(k)
		{
			CodeBarInp(k);	
		}
	}
	
	return 0;
}
/****************************************************************************
* 函数名：ProcessCODE93()
* 功  能：主程序
*
* 说  明：
CODE39_S
****************************************************************************/
int ProcessCODE93(void)
{
	unsigned short m_BarData;
	unsigned short m_BData93;
	unsigned short m_Barlen;
	unsigned short i,m;
	unsigned char k;
	unsigned int sum;
	unsigned int mul;

	unsigned char m_valu_C;
	g_BarLen = 0;
	g_count = 0;
	g_DataBuf = 0;
	i =0;
	sum = 0;
	mul =0;
	g_Prolen = s_CodeBarCon.m_BarSpace & 0xf;
	g_count = s_CodeBarCon.m_BarSpace >> 4;
	g_DataBuf = 0;
	for (i=0;i<BUFFER_SHORT_LENGTH;i++)
	{
		Buffer_CodeBar[i] = 0;
	}
	i = 0;
	CodeBarZoom(9,0x15e);//开始
	//-------------得到93码的长度
	m_Barlen = PrinterCore();//得到条码的长度
	if (m_Barlen > 50)
	{
		m_Barlen = 50;
	}
	//==========得到条码数据=========================
	k = m_Barlen;
	while (k > 20)
	{
		k -= 20;
	}
	for (i=0;i<m_Barlen;i++)
	{
		m_BarData = PrinterCore();//得到code93码
		CodeBarStr[i] = m_BarData;
		m_BarData = (m_BarData - 0x20) << 1;//减去0x20后 * 2
		m_BData93 = CODE93[m_BarData];
		CodeBarZoom(9,m_BData93);
		mul = CODE93[m_BarData + 1];//得到位权的值
		mul = mul * k;
		sum += mul;
		k--;
		if (k == 0)
		{
			k =20;
		}
	}
	//========计算C值
	while (sum >= 47)
	{
		sum -= 47;
	}
	m_valu_C = sum;
	m_BData93 = CODE93_T[sum];
	CodeBarZoom(9,m_BData93);
	//===================================
	//========计算K值
	sum = 0;
	k = m_Barlen+1;
	while(k > 15)
	{
		k -= 15;

	}
	for (m=0;m<m_Barlen;m++)
	{
		m_BarData = CodeBarStr[m];
		m_BarData = (m_BarData - 0x20) << 1;//减去0x20后 * 2
		mul = CODE93[m_BarData + 1];//得到位权的值
		mul = mul * k;
		sum += mul;
		k --;
		if (k == 0)
		{
			k =15;
		}
	}
	sum +=m_valu_C;
	while (sum >= 47)
	{
		sum -= 47;
	}
	m_BData93 = CODE93_T[sum];
	CodeBarZoom(9,m_BData93);
	//===================================
//	CodeBarZoom(9,0x15e);//结束
	CodeBarZoom(10,0x2bd);//结束

	g_DataBuf = g_DataBuf << (16 - g_Prolen);
	Buffer_CodeBar[g_count++]= g_DataBuf;

	CodeBarStr[i++] = 0x0d;
	s_PrintOrderstr.m_GetdataPos = i;
	s_PrintOrderstr.pSpecialposition = CodeBarStr;

	if(g_alignType)
	{
		if(g_BarLen < PRINT_HEAD_LENGTH )
		{
			if(g_alignType == 1)
			{
					k = (PRINT_HEAD_LENGTH - g_BarLen )/2;
			}
			else
			{
				k = (PRINT_HEAD_LENGTH - g_BarLen );
			}
		}
		if(k)
		{
			CodeBarInp(k);	
		}
	}
	
	return 0;
}
/****************************************************************************
* 函数名：ProcessITF25()
* 功  能：主程序
*
* 说  明：
CODE39_S
****************************************************************************/
int ProcessITF25(unsigned char I_BarType)
{
	unsigned short m_BarData;
	unsigned short m_Barlen;
	unsigned short i,m,k,l;
	unsigned int	m_data;
	g_count = 0;
	g_BarLen = 0;
	g_DataBuf = 0;
	i =0;
	g_Prolen = s_CodeBarCon.m_BarSpace & 0xf;
	g_count = s_CodeBarCon.m_BarSpace >> 4;
	g_DataBuf = 0;
	for (i=0;i<BUFFER_SHORT_LENGTH;i++)
	{
		Buffer_CodeBar[i] = 0;
	}
	CodeBarZoom(4,0x0A);//起始码

	//-------------开头数据
	if(I_BarType == 5)
	{
		m_Barlen = 50;
	}
	else
	{
		m_Barlen = PrinterCore();//得到条码的长度
	}
	//----------------------------
	i = 0;
	for (m=0;m<m_Barlen;m++)
	{
		m_BarData = PrinterCore();//得到条码的数据
		if (m_BarData == 0)
		{
			break;
		}
		CodeBarStr[i++] = m_BarData;
	}
	if((m & 1) == 1)
	{
		m--;
	}
	m_Barlen = m >> 1;
	k =0;
	while (m_Barlen >0)
	{
		m_BarData = CodeBarStr[k++] - 0x30;
		m_BarData = ITF25_VE[m_BarData];
		m = CodeBarStr[k++] - 0x30;
		m = ITF25_VE[m];
		m_data = 0;
		for (l=0;l<5;l++)
		{
			m_BarData = m_BarData<<1;
			if((m_BarData & 0x20) == 0x20)
			{
				m_data = m_data << 2;
				m_data |= 0x3;
			}
			else
			{
				m_data = m_data << 1;
				m_data |= 0x1;
			}
			m = m << 1;
			if((m & 0x20) == 0x20)
			{
				m_data = m_data << 2;
			}
			else
			{
				m_data = m_data << 1;
			}
		}
		CodeBarZoom(14,m_data);
		m_Barlen--;
	}
	//==================================

	CodeBarZoom(4,0x0D);//左护线

	g_DataBuf = g_DataBuf << (16 - g_Prolen);
	Buffer_CodeBar[g_count++]= g_DataBuf;

	CodeBarStr[i++] = 0x0d;
	s_PrintOrderstr.m_GetdataPos = i;
	s_PrintOrderstr.pSpecialposition = CodeBarStr;


	if(g_alignType)
	{
		if(g_BarLen < PRINT_HEAD_LENGTH )
		{
			if(g_alignType == 1)
			{
					k = (PRINT_HEAD_LENGTH - g_BarLen )/2;
			}
			else
			{
				k = (PRINT_HEAD_LENGTH - g_BarLen );
			}
		}
		if(k)
		{
			CodeBarInp(k);	
		}
	}
	
	return 0;
}
/****************************************************************************
* 函数名：ProcessCODABAR(unsigned char I_BarType)
* 功  能：主程序
*
* 说  明：
CODE39_S
****************************************************************************/
int ProcessCODABAR(unsigned char I_BarType)
{
	unsigned short m_BarData;
	unsigned short m_Barlen;
	unsigned short i,m,k,l;
	unsigned int	m_data;
	g_count = 0;
	g_DataBuf = 0;
	g_BarLen = 0;
	i =0;
	g_Prolen = s_CodeBarCon.m_BarSpace & 0xf;
	g_count = s_CodeBarCon.m_BarSpace >> 4;
	g_DataBuf = 0;
	for (i=0;i<BUFFER_SHORT_LENGTH;i++)
	{
		Buffer_CodeBar[i] = 0;
	}
	//-------------开头数据
	if(I_BarType == 6)
	{
		m_Barlen = 50;
	}
	else
	{
		m_Barlen = PrinterCore();//得到条码的长度
	}

	i = 0;
	for (m=0;m<m_Barlen;m++)
	{
		m_BarData = PrinterCore();//得到条码的数据
		if (m_BarData == 0)
		{
			break;
		}
		CodeBarStr[i++] = m_BarData;
	}
	m_Barlen = m;
	//----------------------------
	m = 0;
	while (m_Barlen >0)
	{
		m_data = 0;
		l = 0;
		m_BarData = CodeBarStr[m++];
		m_BarData -= 0x20;
		m_BarData = CODABAR[m_BarData];
		m_BarData = m_BarData << 1;
		m_BarData |= 1;
		for (k=0;k<4;k++)
		{
			if((m_BarData & 0x80) == 0x80)
			{
				m_data = m_data << 2;
				m_data |= 3;
				l += 2;
			}
			else
			{
				m_data = m_data << 1;
				m_data |= 1;
				l += 1;
			}
			if((m_BarData & 0x8) == 0x8)
			{
				m_data = m_data << 2;
				l += 2;
			}
			else
			{
				m_data = m_data << 1;
				l += 1;
			}
			m_BarData = m_BarData << 1;
		}
		CodeBarZoom(l,m_data);
		m_Barlen--;
	}
	//==================================

	g_DataBuf = g_DataBuf << (16 - g_Prolen);
	Buffer_CodeBar[g_count++]= g_DataBuf;

	CodeBarStr[i++] = 0x0d;
	s_PrintOrderstr.m_GetdataPos = i;
	s_PrintOrderstr.pSpecialposition = CodeBarStr;

	if(g_alignType)
	{
		if(g_BarLen < PRINT_HEAD_LENGTH )
		{
			if(g_alignType == 1)
			{
					k = (PRINT_HEAD_LENGTH - g_BarLen )/2;
			}
			else
			{
				k = (PRINT_HEAD_LENGTH - g_BarLen );
			}
		}
		if(k)
		{
			CodeBarInp(k);	
		}
	}	
	
	return 0;
}
